# ============================================
# Hello，智多星——企业知识工作流 Agent - 环境变量配置
# 复制为 .env 并填入实际值
# ============================================

# ---- 应用 ----
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- LLM(主:OpenAI 兼容协议) ----
# DeepSeek 示例:OPENAI_BASE_URL=https://api.deepseek.com/v1, PRIMARY_LLM_MODEL=deepseek-v4-pro
# 智谱 GLM 示例:OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4, PRIMARY_LLM_MODEL=glm-4-plus
# 通义千问示例:OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, PRIMARY_LLM_MODEL=qwen-max
# OpenAI 示例:OPENAI_BASE_URL=https://api.openai.com/v1, PRIMARY_LLM_MODEL=gpt-4o
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_LLM_MODEL=deepseek-v4-pro
LITE_LLM_MODEL=deepseek-v4-flash
PRIMARY_LLM_TEMPERATURE=0.2
PRIMARY_LLM_MAX_TOKENS=2048

# ---- LLM(本地降级:Ollama) ----
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_API_KEY=EMPTY

# ---- Embedding(默认本地 bge-m3,1024 维) ----
# 本地:EMBEDDING_PROVIDER=local, EMBEDDING_MODEL 支持 repo id(BAAI/bge-m3,自动下载)或本地路径(如 D:/models/bge-m3)
# OpenAI:EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
HF_HOME=/data/hf_cache

# ---- VectorStore 后端(milvus=生产;memory=开发期 Mock,无需 Docker) ----
VECTOR_STORE_PROVIDER=milvus

# ---- Milvus ----
# 宿主机开发用 localhost;容器内由 docker-compose environment 覆盖为 milvus-standalone
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=enterprise_knowledge
MILVUS_USER=root
MILVUS_PASSWORD=Milvus123

# ---- PostgreSQL ----
# 密码与 docker-compose.yml 开发默认值一致;生产环境务必修改
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=wJ6pbV5eBkzMT2AYDT9w2i8V
POSTGRES_DB=enterprise_agent

# ---- Redis ----
# 密码与 docker-compose.yml 的 --requirepass 一致;生产环境务必修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=V5lOkygYvgaD6ZZ8rmqJAcO7
REDIS_DB=0

# ---- JWT ----
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 小时

# ---- Reranker(local_bge=本地 bge-reranker;cohere;llm;passthrough) ----
RERANKER_PROVIDER=local_bge
RERANKER_MODEL=BAAI/bge-reranker-large  # 支持 repo id 或本地路径(如 D:/models/bge-reranker-large)

# ---- Cohere Reranker(可选,留空时用 LLM 距离降级) ----
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ---- OpenTelemetry tracing(可选,开启后上报 Jaeger) ----
OTEL_ENABLED=false

# ---- LangSmith(可选) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-agent

# ---- 限流 ----
RATE_LIMIT_PER_MINUTE=60

# ---- 知识库反馈循环(点踩+评论自动生成 documents draft 知识候选) ----
KB_FEEDBACK_AUTO_DRAFT=true

# ---- 业务系统(示例) ----
CRM_API_BASE=https://crm.internal/api/v1
MAIL_API_BASE=https://mail.internal/api/v1
TICKET_API_BASE=https://ticket.internal/api/v1
