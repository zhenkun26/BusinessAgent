# ============================================
# Hello，智多星——企业知识工作流 Agent - 环境变量配置
# 复制为 .env 并填入实际值
# ============================================

# ---- 应用 ----
APP_ENV=dev
# Selected external profile for local development and isolated Linux acceptance.
MODEL_PROFILE=bailian-deepseek-v1
# Keep false until real billable API acceptance is authorized.
MODEL_STARTUP_PROBES_ENABLED=false
MODEL_HTTP_TIMEOUT_SECONDS=30
MODEL_HTTP_MAX_RETRIES=2
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---- LLM(主:OpenAI 兼容协议) ----
# DeepSeek 示例:OPENAI_BASE_URL=https://api.deepseek.com/v1, PRIMARY_LLM_MODEL=deepseek-v4-pro
# 智谱 GLM 示例:OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4, PRIMARY_LLM_MODEL=glm-4-plus
# 通义千问示例:OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, PRIMARY_LLM_MODEL=qwen-max
# OpenAI 示例:OPENAI_BASE_URL=https://api.openai.com/v1, PRIMARY_LLM_MODEL=gpt-4o
LLM_PROVIDER=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
PRIMARY_LLM_MODEL=deepseek-v4-pro
LITE_LLM_MODEL=deepseek-flash
PRIMARY_LLM_TEMPERATURE=0.2
PRIMARY_LLM_MAX_TOKENS=2048

# ---- Legacy local development only (clear MODEL_PROFILE to opt out) ----
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=qwen3.5:4b
LOCAL_LLM_API_KEY=EMPTY

# ---- Embedding (selected Beijing Bailian profile, 1024 dimensions) ----
# 本地:EMBEDDING_PROVIDER=local, EMBEDDING_MODEL 支持 repo id(BAAI/bge-m3,自动下载)或本地路径(如 D:/models/bge-m3)
# OpenAI:EMBEDDING_PROVIDER=openai, EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=bailian
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIM=1024
HF_HOME=/data/hf_cache

# ---- VectorStore 后端(milvus=生产;memory=开发期 Mock,无需 Docker) ----
VECTOR_STORE_PROVIDER=milvus

# ---- Milvus ----
# 宿主机开发用 localhost;容器内由 docker-compose environment 覆盖为 milvus-standalone
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=enterprise_knowledge_bailian_v4_1024_v1
MILVUS_USER=root
MILVUS_PASSWORD=Milvus123

# ---- PostgreSQL ----
# 密码与 docker-compose.yml 开发默认值一致;生产环境务必修改
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agent
POSTGRES_PASSWORD=wJ6pbV5eBkzMT2AYDT9w2i8V
POSTGRES_DB=enterprise_agent

# ---- Redis ----
# 密码与 docker-compose.yml 的 --requirepass 一致;生产环境务必修改
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=V5lOkygYvgaD6ZZ8rmqJAcO7
REDIS_DB=0

# ---- JWT ----
# Fresh databases require an explicit administrator bootstrap; no default accounts.
# Production Compose also enforces password verification.
AUTH_REQUIRE_PASSWORD=true
# Required in production; disable only for explicit token-only development.
AUTH_CHECK_DB=true
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480  # 8 小时

# ---- Reranker(local_bge=本地 bge-reranker;cohere;llm;passthrough) ----
RERANKER_PROVIDER=bailian
RERANKER_MODEL=qwen3-rerank
RERANKER_API_KEY=
RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank

# ---- Cohere Reranker(可选,留空时用 LLM 距离降级) ----
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-multilingual-v3.0

# ---- OpenTelemetry tracing(可选,开启后上报 Jaeger) ----
OTEL_ENABLED=false

# ---- LangSmith(可选) ----
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-agent

# ---- 限流 ----
RATE_LIMIT_PER_MINUTE=60

# ---- 知识库反馈循环(点踩+评论自动生成 documents draft 知识候选) ----
KB_FEEDBACK_AUTO_DRAFT=true

# ---- 业务系统(示例) ----
CRM_API_BASE=https://crm.internal/api/v1
MAIL_API_BASE=https://mail.internal/api/v1
TICKET_API_BASE=https://ticket.internal/api/v1
# 全局提供方:mock(默认) / http;逐系统开关留空时继承全局值
TOOL_PROVIDER=mock
CRM_TOOL_PROVIDER=
MAIL_TOOL_PROVIDER=
TICKET_TOOL_PROVIDER=
# 凭证只从环境变量读取,不要提交真实值
CRM_API_TOKEN=
MAIL_API_TOKEN=
TICKET_API_TOKEN=
EXTERNAL_TIMEOUT_SECONDS=10
EXTERNAL_MAX_RETRIES=2
# C12: explicit controlled reference contract. Leave blank until isolated provisioning.
TOOL_REFERENCE_PROFILE=
TOOL_REFERENCE_RUN_ID=
TOOL_REFERENCE_PRINCIPAL=
# Mutation retries are disabled; EXTERNAL_MAX_RETRIES applies to reads only (max 2).

# ---- 企业 IdP/OIDC(默认关闭;契约确认后再启用) ----
SSO_ENABLED=false
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_JWKS_URL=
SSO_REDIRECT_URI=
# All SSO endpoints require HTTPS. Optional private CA file; verification is never disabled.
SSO_CA_BUNDLE=
SSO_SCOPES=openid profile email
# Compatibility-only setting: remote department/role claims never grant local authority.
SSO_DEPARTMENT_CLAIM=department
SSO_DEFAULT_ROLE=salesperson
SSO_DEFAULT_DEPARTMENT=

# Checkpoint backend: explicit; no automatic fallback. Memory is dev-only.
CHECKPOINT_BACKEND=redis
CHECKPOINT_TTL_DAYS=7
