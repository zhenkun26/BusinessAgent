# Independent reference image; standard library only, no application imports or dependencies.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv
COPY reference_service ./reference_service
RUN mkdir -p /data && chown 65534:65534 /data \
    && python -B -c "import sqlite3; import reference_service.server"
USER 65534:65534
EXPOSE 8080 8081
HEALTHCHECK --interval=10s --timeout=4s --retries=3 \
    CMD ["python", "-B", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"]
CMD ["python", "-B", "-m", "reference_service.server"]
