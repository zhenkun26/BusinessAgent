# Copy to ignored .env.sso only in a fresh isolated acceptance project.
# No working credential, signing key, certificate or image digest is shipped.
IDP_IMAGE=
IDP_STORE_ID=
IDP_CLIENT_ID=reference-app
IDP_CLIENT_SECRET=
IDP_OPERATOR_TOKEN=
# JSON object: synthetic username -> {"sub": "stable-subject", "password": "..."}
# Require 2-10 distinct subjects and passwords >=16 chars. Do not use real identities.
IDP_USERS_JSON=
# JSON object: key ID -> PEM-encoded private RSA key (2048-4096 bits, exponent 65537).
# Pre-provision 2-10 distinct keys; JSON newlines must be escaped. Do not print Compose config.
IDP_SIGNING_KEYS_JSON=
IDP_ACTIVE_KID=
