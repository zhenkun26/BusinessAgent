REFERENCE_TICKET_READ_TOKEN=
REFERENCE_MAIL_READ_TOKEN=
REFERENCE_CRM_STORE_ID=
REFERENCE_TICKET_STORE_ID=
REFERENCE_MAIL_STORE_ID=
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
