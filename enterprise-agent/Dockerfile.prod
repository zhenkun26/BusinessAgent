# syntax=docker/dockerfile:1@sha256:4edf897a3ffa55b89f906fc8cc78afdb3f1834cc9c7083565e611a8a7d5fe99e
# ============================================================
# Hello，智多星 生产镜像(多阶段极致瘦身)
# 构建: docker build -f Dockerfile.prod -t enterprise-agent:prod .
# 说明:
#   - 默认 slim 镜像使用外部模型服务，不安装本地 ML 依赖。
#   - INSTALL_ML=1 仅为可选本地开发实验，未纳入生产验收。
#   - 运行时以非 root(nobody)运行
#   - Reviewed Linux amd64 inputs: deploy/build-inputs.json; refresh via deploy/DEPLOY.md.
# ============================================================

ARG INSTALL_ML=0
ARG APP_VERSION=1.3.0

# ---------- Stage 1: Builder ----------
FROM python:3.13.16-slim-bookworm@sha256:f040863673aea2570c3ff6a5c3fb4c673a016cbc5375005ad145915922b6b78a AS builder

ARG INSTALL_ML
ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_DEFAULT_TIMEOUT=120

WORKDIR /build

# Wheel-only production inputs; no compiler or implicit source-build dependencies.
COPY Dockerfile.prod /build-info/Dockerfile.prod
COPY deploy/build-inputs.json deploy/requirements-prod.txt deploy/requirements-prod.lock deploy/requirements-ml.txt deploy/debian.sources /build-info/deploy/
COPY scripts/verify_build.py /build-info/scripts/verify_build.py
RUN python -I -B /build-info/scripts/verify_build.py --root /build-info
COPY deploy/requirements-prod.txt deploy/requirements-prod.lock deploy/requirements-ml.txt ./
RUN python -m venv /opt/venv
RUN --mount=type=cache,target=/root/.cache/pip \
    /opt/venv/bin/pip --isolated install --index-url https://pypi.org/simple \
    --only-binary=:all: --require-hashes --no-deps -r requirements-prod.lock

# ML dependencies are already declared by the project; constrain shared base packages.
# RUN flags belong before the shell command, never inside the conditional.
RUN if [ "$INSTALL_ML" = "1" ]; then \
      apt-get -o Dir::Etc::sourcelist=/build-info/deploy/debian.sources -o Dir::Etc::sourceparts=- update \
      && apt-get -o Dir::Etc::sourcelist=/build-info/deploy/debian.sources -o Dir::Etc::sourceparts=- install -y --no-install-recommends build-essential; fi
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ "$INSTALL_ML" = "1" ]; then \
      /opt/venv/bin/pip install 'torch==2.14.1+cpu' --index-url https://download.pytorch.org/whl/cpu \
      && /opt/venv/bin/pip install -c requirements-prod.txt -r requirements-ml.txt; \
    elif [ "$INSTALL_ML" != "0" ]; then exit 1; fi
RUN /opt/venv/bin/pip check

# ---------- Stage 2: Runner ----------
FROM python:3.13.16-slim-bookworm@sha256:f040863673aea2570c3ff6a5c3fb4c673a016cbc5375005ad145915922b6b78a AS runner

# 全局 ARG 需在阶段内重新声明方可引用
ARG APP_VERSION
ARG INSTALL_ML

LABEL org.opencontainers.image.title="Hello 智多星 enterprise agent" \
      org.opencontainers.image.description="企业知识工作流 Agent 生产镜像(精简)" \
      org.opencontainers.image.version="${APP_VERSION}"

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    APP_ENV=prod \
    PATH="/opt/venv/bin:$PATH"

WORKDIR /app

COPY --from=builder /build-info /build-info

# Runtime libraries are required: pure psycopg needs libpq. Fail on installation errors.
# Ignore all inherited/mutable apt sources; signed snapshot verification remains enabled.
# Exact security fixes are verified before continuing; no broad system upgrade.
RUN apt-get -o Dir::Etc::sourcelist=/build-info/deploy/debian.sources -o Dir::Etc::sourceparts=- update \
    && apt-get -o Dir::Etc::sourcelist=/build-info/deploy/debian.sources -o Dir::Etc::sourceparts=- install -y --no-install-recommends ca-certificates tzdata libpq5 \
        apt=2.6.2 libapt-pkg6.0=2.6.2 libssl3=3.0.22-1~deb12u2 openssl=3.0.22-1~deb12u2 \
    && test "$(dpkg-query -W -f='${Version}' apt)" = "2.6.2" \
    && test "$(dpkg-query -W -f='${Version}' libapt-pkg6.0)" = "2.6.2" \
    && test "$(dpkg-query -W -f='${Version}' libssl3)" = "3.0.22-1~deb12u2" \
    && test "$(dpkg-query -W -f='${Version}' openssl)" = "3.0.22-1~deb12u2" \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/logs /data/observability /data/monitor /data/receiver && chown -R 65534:65534 /app /data

# 安全加固：移除 pip（运行时不需要），消除其 vendor 的 msgpack/pkg_resources 旧版本漏洞
# Trivy 阻断的 GHSA-6v7p-g79w-8964 / CVE-2025-47273 均来自 pip 内部捆绑，无法通过升级 pip 修复
RUN /usr/local/bin/python -m pip uninstall -y pip --break-system-packages

# 仅复制 Python 依赖(venv),不复制 builder 工具链
COPY --from=builder /opt/venv /opt/venv

# venv 已复制后，再清理其 pip 及内部 vendor 内容
RUN /opt/venv/bin/python -m pip uninstall -y pip

# 应用代码
COPY app ./app
COPY scripts/verify_frontend_assets.py ./deploy/verify_frontend_assets.py
COPY scripts/recovery_archive.py ./deploy/recovery_archive.py
COPY deploy/*.sql ./deploy/
COPY deploy/schema_manifest.json ./deploy/
COPY deploy/migrations ./deploy/migrations

USER 65534:65534

# Compare the actual final package set; experimental ML never inherits production PASS.
RUN if [ "$INSTALL_ML" = "0" ]; then \
      python -I -B /build-info/scripts/verify_build.py --root /build-info --installed; \
    else \
      python -I -B /build-info/scripts/verify_build.py --root /build-info --installed --profile experimental-ml; fi

# Verify the final runtime and non-root user can import the PostgreSQL checkpoint stack.
# Imports only: no connection, migration or model inference.
RUN python -c "import psycopg; from langgraph.checkpoint.postgres.aio import AsyncPostgresSaver"

# C19: import only; real key/signature/TLS acceptance remains an isolated runtime gate.
RUN python -B -c "import cryptography; from jwt.algorithms import RSAAlgorithm"

# C20: verify bundled browser assets without browser startup or external access.
RUN python -I -B deploy/verify_frontend_assets.py app/static

EXPOSE 8000

# 健康检查(无 curl,用标准库 urllib;区分存活与就绪见 K8s 探针)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4); sys.exit(0)"]

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
